# ============================================================
# ハピネス5 ／ みんなの水場 の環境変数
# このファイルをコピーして .env.local を作る（.env.local は絶対にコミットしない）。
# 値はここには書かない。読み込みは lib/config.ts にまとめてある。
#
# 組織ごとに別の Vercel プロジェクトを作り、それぞれに設定する。
# 「既定値あり」の項目は、未設定なら1つ目の組織と同じ値になる。
# ============================================================

# --- 共有（どの組織のプロジェクトでも同じ値） -------------------
# サービスアカウント。3つのシートすべてに閲覧権限を付けておくこと
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Vercel では改行が \n のまま入るが、lib/config.ts で復元する
GOOGLE_PRIVATE_KEY=
# OAuth クライアント。リダイレクトURIに各ドメインの /api/auth/callback/google を登録すること
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 組織ごと（必須。既定値なし） -------------------------------
# マインド（ハピネス5回答）のスプレッドシートID
MIND_SHEET_ID=
# ありがとうカードのスプレッドシートID
THANKS_SHEET_ID=
# メンバー名簿のスプレッドシートID
ROSTER_SHEET_ID=
# マインド投稿フォームのURL（「今日の一滴を落とす」）。ビルド時に埋め込まれる
NEXT_PUBLIC_FORM_MIND=
# ありがとうカードフォームのURL（「ありがとうを贈る」）。ビルド時に埋め込まれる
NEXT_PUBLIC_FORM_THANKS=
# そのプロジェクトの公開URL（例: https://xxx.vercel.app）
NEXTAUTH_URL=
# セッション暗号化の鍵。組織ごとに別の値にすることを推奨
NEXTAUTH_SECRET=

# --- 組織ごと（任意。既定値あり） -------------------------------
# マインドのタブ名（既定値: ハピネス）
TAB_MIND=
# ありがとうカードのタブ名（既定値: フォームの回答 1）
TAB_THANKS=
# メンバー名簿のタブ名（既定値: シート1）
TAB_ROSTER=
# 全集計から除外する名前（カンマ区切り。既定値: なし）
TEST_NAMES=
# 画面の名前（既定値: みんなの水場）。ビルド時に埋め込まれる
NEXT_PUBLIC_APP_NAME=
# ヘッダーの副題（既定値: ハピネス5）。ビルド時に埋め込まれる
NEXT_PUBLIC_PRODUCT_NAME=
